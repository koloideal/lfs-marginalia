# Версии, на которых содержимое этого репозитория реально собрано и проверено.
# При отличии версий модификация может всё равно подойти — см. поле `lfs`
# в README конкретного мода и прогоните `patch --dry-run` до применения.
#
# Значения ведутся по книгам семейства *LFS: блок LFS — базовая система,
# блок BLFS — пакеты поверх неё. BLFS нумеруется по линейке LFS
# (BLFS 13.1 соответствует LFS 13.1); поле заполняется при появлении
# первого BLFS-мода или BLFS-конфига в профиле.

# --- LFS ---
LFS_VERSION=13.1
LFS_EDITION=systemd
KERNEL_VERSION=7.2.10
HOST_DISTRO="Arch Linux"
HOST_ARCH=x86_64

# --- BLFS ---
BLFS_VERSION=
